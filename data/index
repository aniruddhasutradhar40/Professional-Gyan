<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Practice Data</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #e4e8f0;
    --ink: #1c2033;
    --muted: #4a5470;
    --green: #1fae5b;
    --shadow-dark: rgba(163, 177, 198, 0.65);
    --shadow-light: rgba(255, 255, 255, 0.9);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: "Poppins", "Hind Siliguri", "Noto Sans Bengali", "Segoe UI", system-ui, sans-serif;
    line-height: 1.7;
    padding: 48px 20px;
  }
  main { max-width: 560px; margin: 0 auto; }
  h1 { font-size: 2rem; font-weight: 500; margin: 0 0 6px; }
  .sub { color: var(--muted); margin: 0 0 32px; }

  /* raised neumorphic card */
  .group {
    background: var(--bg);
    border-radius: 24px;
    box-shadow: 9px 9px 18px var(--shadow-dark), -9px -9px 18px var(--shadow-light);
    padding: 20px;
  }

  /* raised neumorphic button (same look as the site's Enrollment Details button) */
  .toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 20px;
    background: var(--bg);
    border: 0;
    border-radius: 14px;
    box-shadow: 6px 6px 12px var(--shadow-dark), -6px -6px 12px var(--shadow-light);
    color: var(--ink);
    font: inherit;
    font-size: 1.05rem;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
  }
  .toggle[aria-expanded="true"] {
    box-shadow: inset 5px 5px 10px var(--shadow-dark), inset -5px -5px 10px var(--shadow-light);
  }
  .toggle:focus-visible { outline: 3px solid var(--green); outline-offset: 3px; }
  .chev { transition: transform .2s; color: var(--green); font-size: .8rem; }
  .toggle[aria-expanded="true"] .chev { transform: rotate(180deg); }

  .panel { display: none; padding-top: 18px; }
  .panel.open { display: block; }
  .panel h2 { margin: 0 0 14px; font-size: 1.05rem; font-weight: 500; }

  /* pressed-in list holding the links, like the Service Charge box */
  .links {
    list-style: none;
    margin: 0;
    padding: 6px 18px;
    border-radius: 14px;
    box-shadow: inset 5px 5px 10px var(--shadow-dark), inset -5px -5px 10px var(--shadow-light);
  }
  .links li { padding: 12px 0; border-bottom: 1px solid rgba(163, 177, 198, 0.35); }
  .links li:last-child { border-bottom: 0; }
  .links a { color: var(--green); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .links a:hover { filter: brightness(.85); }
  .links a:focus-visible { outline: 3px solid var(--green); outline-offset: 3px; border-radius: 4px; }
</style>
</head>
<body>
<main>
  <h1>Practice Data</h1>
  <p class="sub">Free Practice File ডাউনলোড করুন।</p>

  <section class="group">
    <button class="toggle" type="button" aria-expanded="false" aria-controls="excel-panel">
      <span>Basic Excel</span><span class="chev" aria-hidden="true">▼</span>
    </button>

    <div class="panel" id="excel-panel">
      <h2>Excel Resources</h2>
      <ul class="links">
        <li><a href="https://github.com/aniruddhasutradhar40/Professional-Gyan/raw/main/Excel%20Data%201.xlsx" download>Practice File 1</a></li>
        <li><a href="https://github.com/aniruddhasutradhar40/Professional-Gyan/raw/main/Excel%20Data%202.xlsx" download>Practice File 2</a></li>
      </ul>
    </div>
  </section>
</main>

<script>
  document.querySelectorAll('.toggle').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      document.getElementById(btn.getAttribute('aria-controls')).classList.toggle('open', !open);
    });
  });
</script>
</body>
</html>
